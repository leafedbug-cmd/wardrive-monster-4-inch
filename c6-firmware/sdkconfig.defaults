# ESP32-C6 co-processor (ESP-Hosted slave) for the Wardrive Monster.
#
# Merged from esp_hosted's examples/ota/coprocessor_ota/cp defaults
# (base + esp32c6), with Bluetooth turned ON -- the stock example ships
# with BT disabled, and this project's whole BLE screen depends on it.

CONFIG_IDF_TARGET="esp32c6"

# ---------------------------------------------------------------- role
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

# ---------------------------------------------------------------- features
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_HOSTED_CP_FEAT_SYSTEM=y

# Bluetooth: controller only. The NimBLE *host* runs on the P4 and reaches
# this controller through HCI tunnelled over the SDIO link, so HCI must be
# VHCI/RAM here -- NOT the UART variant, which would need wires the board
# does not route.
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y
CONFIG_ESP_HOSTED_CP_AUTO_START_BT_ON_HOSTED_INIT=y

CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y
CONFIG_BT_LE_SLEEP_ENABLE=y

# ---------------------------------------------------------------- flash / OTA
# Dual OTA slots are what make the P4 able to reflash this chip over SDIO.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

# ---------------------------------------------------------------- CPU / OS
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CACHE_MALLOC=y

# ---------------------------------------------------------------- Wi-Fi
# Deep RX buffers: this firmware's job is to hoover up beacons and ship
# them over SDIO, so receive capacity matters more than transmit.
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=20
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# ---------------------------------------------------------------- misc
CONFIG_COMPILER_OPTIMIZATION_PERF=y
